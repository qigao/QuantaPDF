# Original W* candidate and admitted PDFium/C11 failures must preserve
# prior success evidence. These four cases never count as pixel positives.
cmake_minimum_required(VERSION 3.24)
foreach(arg IN ITEMS ORACLE ORIGINAL_SOURCE ADMITTED_GUARD CANDIDATE_GUARD OUTPUT_DIR)
  if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
    message(FATAL_ERROR "Missing required ${arg}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(SIZE "${ORIGINAL_SOURCE}" original_bytes)
if(NOT original_bytes EQUAL 3747)
  message(FATAL_ERROR "Original control bytes changed")
endif()
file(SHA256 "${ORIGINAL_SOURCE}" real_sha)
if(NOT real_sha STREQUAL "9d30a67c8194b6822f28ad9ed4848a57c7745e95d11b79267ac5141001a91783")
  message(FATAL_ERROR "Original control SHA-256 changed")
endif()
set(broken "${OUTPUT_DIR}/malformed-3747.pdf")
string(REPEAT "X" 3747 junk)
file(WRITE "${broken}" "${junk}")
file(SHA256 "${broken}" broken_sha)

function(expect_failure wrapper mode kind source expected_sha)
  set(report "${OUTPUT_DIR}/${mode}-${kind}.json")
  set(stage "${report}.tmp")
  set(sentinel "previous-approved-pixel-report-${mode}-${kind}\n")
  if(kind STREQUAL "malformed")
    file(WRITE "${report}" "${sentinel}")
  else()
    file(CREATE_LINK "${source}" "${report}" RESULT linked)
    if(NOT "${linked}" STREQUAL "0")
      message(FATAL_ERROR "Could not establish hardlink alias: ${linked}")
    endif()
  endif()
  file(REMOVE "${stage}")
  execute_process(
    COMMAND "${CMAKE_COMMAND}"
      "-DORACLE=${ORACLE}" "-DSOURCE=${source}"
      "-DREPORT=${report}" "-DEXPECTED_SHA256=${expected_sha}"
      -P "${wrapper}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if("${rc}" STREQUAL "0")
    message(FATAL_ERROR "${mode}/${kind} unexpectedly claimed pixel success")
  endif()
  if(mode STREQUAL "admitted")
    set(expected_error "Original W* PDFium/C11 pixel oracle failed")
  else()
    set(expected_error "Original PDFium vs C11 candidate pixel failed")
  endif()
  string(FIND "${err}" "${expected_error}" wrapper_reason)
  if(wrapper_reason LESS 0)
    message(FATAL_ERROR "${mode}/${kind} did not execute pixel wrapper: ${err}")
  endif()
  if(kind STREQUAL "malformed")
    file(READ "${report}" actual)
    if(NOT actual STREQUAL sentinel)
      message(FATAL_ERROR "${mode}: failed raster deleted/corrupted previous report")
    endif()
    string(FIND "${err}" "quantapdf_open" source_failure)
    if(source_failure LESS 0)
      message(FATAL_ERROR "${mode}: expected original PDF open rejection: ${err}")
    endif()
  else()
    file(SHA256 "${source}" source_after)
    file(SHA256 "${report}" report_after)
    if(NOT source_after STREQUAL expected_sha OR NOT report_after STREQUAL expected_sha)
      message(FATAL_ERROR "${mode}: source/output hardlink mutated despite rejection")
    endif()
    string(FIND "${err}" "fs::equivalent" alias_failure)
    if(alias_failure LESS 0)
      message(FATAL_ERROR "${mode}: output hardlink alias guard did not run: ${err}")
    endif()
  endif()
  if(EXISTS "${stage}")
    message(FATAL_ERROR "${mode}/${kind}: stale staged report leaked")
  endif()
endfunction()

foreach(mode IN ITEMS admitted candidate)
  if(mode STREQUAL "admitted")
    set(wrapper "${ADMITTED_GUARD}")
  else()
    set(wrapper "${CANDIDATE_GUARD}")
  endif()
  expect_failure("${wrapper}" "${mode}" malformed "${broken}" "${broken_sha}")
  set(alias_original "${OUTPUT_DIR}/${mode}-hardlink-original.pdf")
  file(COPY_FILE "${ORIGINAL_SOURCE}" "${alias_original}")
  expect_failure("${wrapper}" "${mode}" alias "${alias_original}" "${real_sha}")
endforeach()
file(SHA256 "${ORIGINAL_SOURCE}" real_after)
if(NOT real_after STREQUAL real_sha)
  message(FATAL_ERROR "Immutable official W* original modified by rejection tests")
endif()
message(STATUS "wstar-pixel-report-guard: 4 fail-closed cases passed; external W* positive unchanged")
