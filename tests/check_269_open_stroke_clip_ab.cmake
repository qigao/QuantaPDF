cmake_minimum_required(VERSION 3.24)
# Test-only single open-segment Stroke A/B: no joins or miter geometry.
foreach(arg IN ITEMS ORACLE REPORT)
  if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
    message(FATAL_ERROR "Missing open Stroke A/B argument ${arg}")
  endif()
endforeach()
if(DEFINED MODE AND MODE STREQUAL "geometry-matrix")
  file(REMOVE "${REPORT}" "${REPORT}.tmp")
  file(WRITE "${REPORT}" "stale published matrix report\n")
  file(WRITE "${REPORT}.tmp" "stale partial matrix report\n")
  execute_process(
    COMMAND "${ORACLE}" --269-open-stroke-geometry-matrix unused --geometry-matrix-report "${REPORT}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 165)
  if(NOT rc STREQUAL "0" OR NOT EXISTS "${REPORT}")
    message(FATAL_ERROR "Open Stroke geometry matrix failed rc=${rc}\n${stdout}\n${stderr}")
  endif()
  if(EXISTS "${REPORT}.tmp")
    message(FATAL_ERROR "Open Stroke geometry matrix left a staging report behind")
  endif()
  file(READ "${REPORT}" report)
  string(JSON route GET "${report}" reference_render_route)
  string(JSON independent GET "${report}" reference_is_independent_pdfium_oracle)
  string(JSON verified GET "${report}" reference_independence_verified)
  string(JSON width GET "${report}" pdfium_bitmap_width)
  string(JSON height GET "${report}" pdfium_bitmap_height)
  string(JSON stride GET "${report}" pdfium_bitmap_rgb_stride)
  string(JSON repeat_pdfium GET "${report}" direct_pdfium_repeat_identical)
  string(JSON repeat_native GET "${report}" native_repeat_rgba_identical)
  string(JSON unchanged GET "${report}" source_bytes_unchanged_after_reference_and_native)
  string(JSON geometry_count GET "${report}" geometry_count)
  string(JSON variants_per_geometry GET "${report}" variants_per_geometry)
  if(NOT route STREQUAL "direct_pdfium_api" OR NOT independent OR NOT verified OR
     NOT width EQUAL 100 OR NOT height EQUAL 50 OR NOT stride EQUAL 300 OR
     NOT repeat_pdfium OR NOT repeat_native OR NOT unchanged OR
     NOT geometry_count EQUAL 7 OR NOT variants_per_geometry EQUAL 3)
    message(FATAL_ERROR "Geometry matrix lacks direct-PDFium provenance or repeat/source invariants")
  endif()
  string(JSON count LENGTH "${report}" cases)
  if(NOT count EQUAL 7)
    message(FATAL_ERROR "Expected seven held-out open Stroke geometries")
  endif()
  set(names diagonal_ascending diagonal_descending horizontal vertical shallow boundary_crossing short_interior)
  set(variants no_clip fullpage_w restrictive_w)
  set(seen_hashes "")
  foreach(i RANGE 0 6)
    string(JSON c GET "${report}" cases ${i})
    string(JSON name GET "${c}" name)
    list(GET names ${i} expected_name)
    string(JSON ref_equal GET "${c}" reference_no_clip_fullpage_w_changed_pixels)
    string(JSON native_equal GET "${c}" native_no_clip_fullpage_w_changed_pixels)
    string(JSON ref_changed GET "${c}" restrictive_w_reference_changed_pixels)
    string(JSON native_changed GET "${c}" restrictive_w_native_changed_pixels)
    string(JSON ref_delta GET "${c}" restrictive_w_reference_rgb_abs_delta)
    string(JSON native_delta GET "${c}" restrictive_w_native_rgb_abs_delta)
    string(JSON provenance_count LENGTH "${c}" source_provenance)
    if(NOT name STREQUAL expected_name OR NOT ref_equal EQUAL 0 OR
       NOT native_equal EQUAL 0 OR ref_changed LESS_EQUAL 0 OR
       native_changed LESS_EQUAL 0 OR ref_changed GREATER 5000 OR
       native_changed GREATER 5000 OR ref_delta LESS_EQUAL 0 OR
       native_delta LESS_EQUAL 0 OR NOT provenance_count EQUAL 3)
      message(FATAL_ERROR "Geometry ${i} failed no-Clip/full-page-W equivalence or restrictive-Clip effect checks")
    endif()
    foreach(v RANGE 0 2)
      string(JSON p GET "${c}" source_provenance ${v})
      list(GET variants ${v} expected_variant)
      string(JSON variant GET "${p}" variant)
      string(JSON hash GET "${p}" source_fnv64)
      string(JSON size_before GET "${p}" source_size_bytes_before)
      string(JSON size_after GET "${p}" source_size_bytes_after)
      string(JSON sha_before GET "${p}" source_sha256_before)
      string(JSON sha_after GET "${p}" source_sha256_after)
      string(LENGTH "${hash}" hash_length)
      string(LENGTH "${sha_before}" sha_length)
      list(FIND seen_hashes "${hash}" duplicate_hash)
      if(NOT variant STREQUAL expected_variant OR NOT hash_length EQUAL 16 OR
         NOT hash MATCHES "^[0-9a-f]+$" OR NOT duplicate_hash EQUAL -1 OR
         NOT size_before GREATER 0 OR NOT size_before EQUAL size_after OR
         NOT sha_length EQUAL 64 OR NOT sha_before MATCHES "^[0-9a-f]+$" OR
         NOT sha_before STREQUAL sha_after)
        message(FATAL_ERROR "Malformed, duplicate, or mutated source provenance at geometry ${i}, variant ${v}")
      endif()
      list(APPEND seen_hashes "${hash}")
    endforeach()
  endforeach()
  list(LENGTH seen_hashes unique_hash_count)
  if(NOT unique_hash_count EQUAL 21)
    message(FATAL_ERROR "Expected 21 unique generated PDF sources in the geometry matrix")
  endif()
  message(STATUS "Open Stroke geometry matrix passed: seven geometries x three clip states; full-page W equals no Clip in direct PDFium and Native; restrictive W affects both.")
  return()
endif()

file(REMOVE "${REPORT}" "${REPORT}.tmp")
# Seed stale destination and staging files to prove fail-closed startup cleanup.
file(WRITE "${REPORT}" "stale published report\n")
file(WRITE "${REPORT}.tmp" "stale partial report\n")
execute_process(
  COMMAND "${ORACLE}" --269-open-stroke-clip-ab unused --open-stroke-report "${REPORT}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 90)
if(NOT rc STREQUAL "0" OR NOT EXISTS "${REPORT}")
  message(FATAL_ERROR "Open Stroke/Clip A/B failed rc=${rc}\n${stdout}\n${stderr}")
endif()
if(EXISTS "${REPORT}.tmp")
  message(FATAL_ERROR "Open Stroke/Clip A/B left a staging report behind")
endif()
file(READ "${REPORT}" report)
string(JSON oracle_route GET "${report}" reference_render_route)
string(JSON oracle_independent GET "${report}" reference_is_independent_pdfium_oracle)
string(JSON oracle_verified GET "${report}" reference_independence_verified)
string(JSON pdfium_width GET "${report}" pdfium_bitmap_width)
string(JSON pdfium_height GET "${report}" pdfium_bitmap_height)
string(JSON pdfium_stride GET "${report}" pdfium_bitmap_rgb_stride)
string(JSON repeat_pdfium GET "${report}" direct_pdfium_repeat_identical)
string(JSON repeat_native GET "${report}" native_repeat_rgba_identical)
string(JSON source_unchanged GET "${report}" source_bytes_unchanged_after_reference_and_native)
if(NOT oracle_route STREQUAL "direct_pdfium_api" OR NOT oracle_independent OR
   NOT oracle_verified OR NOT pdfium_width EQUAL 100 OR
   NOT pdfium_height EQUAL 50 OR NOT pdfium_stride EQUAL 300 OR
   NOT repeat_pdfium OR NOT repeat_native OR NOT source_unchanged)
  message(FATAL_ERROR "Open Stroke report lacks verified direct-PDFium provenance/repeat/source invariants")
endif()
foreach(k IN ITEMS
    open_line_only
    no_clip_and_fullpage_w_reference_equal
    no_clip_and_fullpage_w_native_equal
    all_three_native_supported)
  string(JSON yes GET "${report}" ${k})
  if(NOT yes)
    message(FATAL_ERROR "Open Stroke A/B invariant ${k} is false")
  endif()
endforeach()
foreach(k IN ITEMS restrictive_w_changes_reference restrictive_w_changes_native)
  string(JSON n GET "${report}" ${k})
  if(n LESS_EQUAL 0)
    message(FATAL_ERROR "Restrictive W did not affect ${k}")
  endif()
endforeach()
string(JSON count LENGTH "${report}" cases)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Expected exactly three open Stroke cases")
endif()
set(names no_clip fullpage_w restrictive_w)
set(seen "")
foreach(i RANGE 0 2)
  string(JSON c GET "${report}" cases ${i})
  string(JSON name GET "${c}" name)
  string(JSON hash GET "${c}" source_fnv64)
  string(JSON pixels GET "${c}" different_pixels)
  string(JSON rgb GET "${c}" rgb_abs)
  string(JSON bounds_count LENGTH "${c}" different_pixel_bounds)
  string(JSON rows_count LENGTH "${c}" error_rows)
  string(JSON cols_count LENGTH "${c}" error_cols)
  list(GET names ${i} expected)
  list(FIND seen "${hash}" duplicate)
  if(NOT name STREQUAL expected OR NOT hash MATCHES "^[0-9a-f]+$" OR
     NOT duplicate EQUAL -1 OR pixels LESS 0 OR rgb LESS 0 OR
     NOT bounds_count EQUAL 4 OR NOT rows_count EQUAL 50 OR
     NOT cols_count EQUAL 100)
    message(FATAL_ERROR "Invalid/duplicate open Stroke case ${i}")
  endif()
  list(APPEND seen "${hash}")
endforeach()
foreach(k IN ITEMS restrictive_w_reference_bounds restrictive_w_native_bounds)
  string(JSON bounds_count LENGTH "${report}" ${k})
  if(NOT bounds_count EQUAL 4)
    message(FATAL_ERROR "Missing pixel bounds diagnostic ${k}")
  endif()
endforeach()
foreach(k IN ITEMS
    restrictive_w_reference_changed_rows restrictive_w_native_changed_rows)
  string(JSON n LENGTH "${report}" ${k})
  if(NOT n EQUAL 50)
    message(FATAL_ERROR "Missing 50-row clip histogram ${k}")
  endif()
endforeach()
foreach(k IN ITEMS
    restrictive_w_reference_changed_cols restrictive_w_native_changed_cols)
  string(JSON n LENGTH "${report}" ${k})
  if(NOT n EQUAL 100)
    message(FATAL_ERROR "Missing 100-column clip histogram ${k}")
  endif()
endforeach()
foreach(i RANGE 0 2)
  string(JSON c GET "${report}" cases ${i})
  string(JSON map_count LENGTH "${c}" error_map)
  if(NOT map_count EQUAL 50)
    message(FATAL_ERROR "Expected 50-row per-pixel mismatch map for case ${i}")
  endif()
  set(map_x_count 0)
  foreach(y RANGE 0 49)
    string(JSON row GET "${c}" error_map ${y})
    string(LENGTH "${row}" row_width)
    if(NOT row_width EQUAL 100 OR NOT row MATCHES "^[X.]+$")
      message(FATAL_ERROR "Invalid per-pixel mismatch map row ${y} for case ${i}")
    endif()
    string(REGEX MATCHALL "X" row_x_marks "${row}")
    list(LENGTH row_x_marks row_x_count)
    math(EXPR map_x_count "${map_x_count} + ${row_x_count}")
  endforeach()
  string(JSON mismatch_count LENGTH "${c}" mismatch_pixels)
  string(JSON expected_mismatch_count GET "${c}" different_pixels)
  if(NOT mismatch_count EQUAL expected_mismatch_count OR
     NOT map_x_count EQUAL expected_mismatch_count)
    message(FATAL_ERROR "Mismatch evidence, map X count, and different_pixels disagree for case ${i}")
  endif()
  set(seen_coordinates "")
  foreach(p RANGE 0 ${mismatch_count})
    if(p LESS mismatch_count)
      string(JSON pixel GET "${c}" mismatch_pixels ${p})
      string(JSON px GET "${pixel}" x)
      string(JSON py GET "${pixel}" y)
      if(px LESS 0 OR px GREATER 99 OR py LESS 0 OR py GREATER 49)
        message(FATAL_ERROR "Out-of-bounds mismatch pixel in case ${i}")
      endif()
      set(coordinate "${px},${py}")
      list(FIND seen_coordinates "${coordinate}" duplicate_coordinate)
      if(NOT duplicate_coordinate EQUAL -1)
        message(FATAL_ERROR "Duplicate mismatch coordinate ${coordinate} in case ${i}")
      endif()
      list(APPEND seen_coordinates "${coordinate}")
      string(JSON row GET "${c}" error_map ${py})
      string(SUBSTRING "${row}" ${px} 1 marker)
      if(NOT marker STREQUAL "X")
        message(FATAL_ERROR "Mismatch evidence does not point to X in case ${i}")
      endif()
      foreach(channel_array IN ITEMS reference_rgb native_rgb_on_white native_rgba)
        string(JSON channel_count LENGTH "${pixel}" ${channel_array})
        if(channel_array STREQUAL "native_rgba")
          set(expected_channels 4)
        else()
          set(expected_channels 3)
        endif()
        if(NOT channel_count EQUAL expected_channels)
          message(FATAL_ERROR "Invalid ${channel_array} width in case ${i}")
        endif()
        math(EXPR last_channel "${channel_count} - 1")
        foreach(ch RANGE 0 ${last_channel})
          string(JSON value GET "${pixel}" ${channel_array} ${ch})
          if(value LESS 0 OR value GREATER 255)
            message(FATAL_ERROR "Invalid channel value in ${channel_array} for case ${i}")
          endif()
        endforeach()
      endforeach()
      string(JSON alpha GET "${pixel}" native_rgba 3)
      # Native uses 4x4 binary sample coverage: alpha must be round(n*255/16).
      set(alpha_on_16_sample_lattice FALSE)
      foreach(sample_count RANGE 0 16)
        math(EXPR expected_alpha "(${sample_count} * 255 + 8) / 16")
        if(alpha EQUAL expected_alpha)
          set(alpha_on_16_sample_lattice TRUE)
        endif()
      endforeach()
      if(NOT alpha_on_16_sample_lattice)
        message(FATAL_ERROR "Native alpha ${alpha} is off the 4x4 coverage lattice at ${coordinate}")
      endif()
      set(rgb_differs FALSE)
      foreach(ch RANGE 0 2)
        string(JSON ref_value GET "${pixel}" reference_rgb ${ch})
        string(JSON native_value GET "${pixel}" native_rgb_on_white ${ch})
        string(JSON rgba_value GET "${pixel}" native_rgba ${ch})
        math(EXPR composite_value "(${rgba_value} * ${alpha} + 255 * (255 - ${alpha}) + 127) / 255")
        if(NOT composite_value EQUAL native_value)
          message(FATAL_ERROR "native_rgb_on_white is inconsistent with native_rgba over white at ${coordinate}")
        endif()
        if(NOT ref_value EQUAL native_value)
          set(rgb_differs TRUE)
        endif()
      endforeach()
      if(NOT rgb_differs)
        message(FATAL_ERROR "Mismatch coordinate ${coordinate} has identical reference/native RGB")
      endif()
    endif()
  endforeach()
endforeach()
foreach(k IN ITEMS restrictive_w_reference_changed_map restrictive_w_native_changed_map)
  string(JSON map_count LENGTH "${report}" ${k})
  if(NOT map_count EQUAL 50)
    message(FATAL_ERROR "Expected 50-row clip-change map ${k}")
  endif()
  foreach(y RANGE 0 49)
    string(JSON row GET "${report}" ${k} ${y})
    string(LENGTH "${row}" row_width)
    if(NOT row_width EQUAL 100 OR NOT row MATCHES "^[X.]+$")
      message(FATAL_ERROR "Invalid clip-change map row ${y} in ${k}")
    endif()
  endforeach()
endforeach()
list(LENGTH seen unique_count)
if(NOT unique_count EQUAL 3)
  message(FATAL_ERROR "Open Stroke sources are not distinct")
endif()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
execute_process(
  COMMAND "${Python3_EXECUTABLE}"
    "${CMAKE_CURRENT_LIST_DIR}/check_269_open_stroke_clip_ab_pixels.py"
    "${REPORT}"
  RESULT_VARIABLE pixel_rc
  OUTPUT_VARIABLE pixel_stdout
  ERROR_VARIABLE pixel_stderr
  TIMEOUT 45)
if(NOT pixel_rc STREQUAL "0")
  message(FATAL_ERROR
    "Open Stroke per-pixel diagnostic validation failed rc=${pixel_rc}\n"
    "${pixel_stdout}\n${pixel_stderr}")
endif()
message(STATUS "${pixel_stdout}")
message(STATUS "Open-line Stroke A/B passed: no Clip == full-page W in PDFium and Native; restrictive W changes both; diagnostic only.")
