cmake_minimum_required(VERSION 3.24)
# Test-only single open-segment Stroke A/B: no joins or miter geometry.
foreach(arg IN ITEMS ORACLE REPORT)
  if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
    message(FATAL_ERROR "Missing open Stroke A/B argument ${arg}")
  endif()
endforeach()
file(REMOVE "${REPORT}")
execute_process(
  COMMAND "${ORACLE}" --269-open-stroke-clip-ab unused --open-stroke-report "${REPORT}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 90)
if(NOT rc STREQUAL "0" OR NOT EXISTS "${REPORT}")
  message(FATAL_ERROR "Open Stroke/Clip A/B failed rc=${rc}\n${stdout}\n${stderr}")
endif()
file(READ "${REPORT}" report)
foreach(k IN ITEMS
    open_line_only
    no_clip_and_fullpage_w_reference_equal
    no_clip_and_fullpage_w_native_equal
    all_three_native_supported)
  string(JSON yes GET "${report}" ${k})
  if(NOT yes)
    message(FATAL_ERROR "Open Stroke A/B invariant ${k} is false")
  endif()
endforeach()
foreach(k IN ITEMS restrictive_w_changes_reference restrictive_w_changes_native)
  string(JSON n GET "${report}" ${k})
  if(n LESS_EQUAL 0)
    message(FATAL_ERROR "Restrictive W did not affect ${k}")
  endif()
endforeach()
string(JSON count LENGTH "${report}" cases)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Expected exactly three open Stroke cases")
endif()
set(names no_clip fullpage_w restrictive_w)
set(seen "")
foreach(i RANGE 0 2)
  string(JSON c GET "${report}" cases ${i})
  string(JSON name GET "${c}" name)
  string(JSON hash GET "${c}" source_fnv64)
  string(JSON pixels GET "${c}" different_pixels)
  string(JSON rgb GET "${c}" rgb_abs)
  string(JSON bounds_count LENGTH "${c}" different_pixel_bounds)
  string(JSON rows_count LENGTH "${c}" error_rows)
  string(JSON cols_count LENGTH "${c}" error_cols)
  list(GET names ${i} expected)
  list(FIND seen "${hash}" duplicate)
  if(NOT name STREQUAL expected OR NOT hash MATCHES "^[0-9a-f]+$" OR
     NOT duplicate EQUAL -1 OR pixels LESS 0 OR rgb LESS 0 OR
     NOT bounds_count EQUAL 4 OR NOT rows_count EQUAL 50 OR
     NOT cols_count EQUAL 100)
    message(FATAL_ERROR "Invalid/duplicate open Stroke case ${i}")
  endif()
  list(APPEND seen "${hash}")
endforeach()
foreach(k IN ITEMS restrictive_w_reference_bounds restrictive_w_native_bounds)
  string(JSON bounds_count LENGTH "${report}" ${k})
  if(NOT bounds_count EQUAL 4)
    message(FATAL_ERROR "Missing pixel bounds diagnostic ${k}")
  endif()
endforeach()
foreach(k IN ITEMS
    restrictive_w_reference_changed_rows restrictive_w_native_changed_rows)
  string(JSON n LENGTH "${report}" ${k})
  if(NOT n EQUAL 50)
    message(FATAL_ERROR "Missing 50-row clip histogram ${k}")
  endif()
endforeach()
foreach(k IN ITEMS
    restrictive_w_reference_changed_cols restrictive_w_native_changed_cols)
  string(JSON n LENGTH "${report}" ${k})
  if(NOT n EQUAL 100)
    message(FATAL_ERROR "Missing 100-column clip histogram ${k}")
  endif()
endforeach()
foreach(i RANGE 0 2)
  string(JSON c GET "${report}" cases ${i})
  string(JSON map_count LENGTH "${c}" error_map)
  if(NOT map_count EQUAL 50)
    message(FATAL_ERROR "Expected 50-row per-pixel mismatch map for case ${i}")
  endif()
  foreach(y RANGE 0 49)
    string(JSON row GET "${c}" error_map ${y})
    string(LENGTH "${row}" row_width)
    if(NOT row_width EQUAL 100 OR NOT row MATCHES "^[X.]+$")
      message(FATAL_ERROR "Invalid per-pixel mismatch map row ${y} for case ${i}")
    endif()
  endforeach()
endforeach()
foreach(k IN ITEMS restrictive_w_reference_changed_map restrictive_w_native_changed_map)
  string(JSON map_count LENGTH "${report}" ${k})
  if(NOT map_count EQUAL 50)
    message(FATAL_ERROR "Expected 50-row clip-change map ${k}")
  endif()
  foreach(y RANGE 0 49)
    string(JSON row GET "${report}" ${k} ${y})
    string(LENGTH "${row}" row_width)
    if(NOT row_width EQUAL 100 OR NOT row MATCHES "^[X.]+$")
      message(FATAL_ERROR "Invalid clip-change map row ${y} in ${k}")
    endif()
  endforeach()
endforeach()
list(LENGTH seen unique_count)
if(NOT unique_count EQUAL 3)
  message(FATAL_ERROR "Open Stroke sources are not distinct")
endif()
message(STATUS "Open-line Stroke A/B passed: no Clip == full-page W in PDFium and Native; restrictive W changes both; diagnostic only.")
