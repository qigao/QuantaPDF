# #269 signed-Q4 threshold counterexamples, TEST ONLY. Executed via
# parent CMake original-source checker with validated report in "report".
if(NOT DEFINED report OR report STREQUAL "")
  message(FATAL_ERROR "Previous original-PDF held-out report not available")
endif()
string(JSON signed_flag GET "${report}" signed_model_audit_test_only)
string(JSON global_len LENGTH "${report}" total_signed_scores)
string(JSON by_dpi_len LENGTH "${report}" signed_by_dpi)
string(JSON pinned_count GET "${report}" signed_regression_144_frames)
if(NOT signed_flag OR NOT global_len EQUAL 7 OR
   NOT by_dpi_len EQUAL 3 OR NOT pinned_count EQUAL 2)
  message(FATAL_ERROR "Signed alpha 144DPI held-out counterexample ledger absent")
endif()
set(signed_names
  native_q4_white_composite
  q4_alpha_threshold_1_of_16
  q4_alpha_threshold_4_of_16
  q4_alpha_threshold_8_of_16
  q4_alpha_threshold_12_of_16
  q4_alpha_threshold_16_of_16
  independent_pixel_center)
foreach(m RANGE 0 6)
  set(u_${m} 0)
  set(o_${m} 0)
  set(c_${m} 0)
  set(ua_${m} 0)
  set(oa_${m} 0)
  set(ca_${m} 0)
  foreach(d RANGE 0 2)
    set(ud_${d}_${m} 0)
    set(od_${d}_${m} 0)
    set(cd_${d}_${m} 0)
    set(uad_${d}_${m} 0)
    set(oad_${d}_${m} 0)
    set(cad_${d}_${m} 0)
  endforeach()
endforeach()
set(pinned_observations 0)
foreach(i RANGE 0 95)
  string(JSON signed_len LENGTH "${report}" frames ${i} signed_scores)
  string(JSON ref_partial GET "${report}" frames ${i} reference_partial_pixels)
  if(NOT signed_len EQUAL 7 OR NOT ref_partial EQUAL 0)
    message(FATAL_ERROR "Heldout original PDFium binary reference/signed model missing")
  endif()
  math(EXPR d "${i}%3")
  foreach(m RANGE 0 6)
    list(GET signed_names ${m} expected)
    string(JSON name GET "${report}" frames ${i} signed_scores ${m} method)
    string(JSON under GET "${report}" frames ${i} signed_scores ${m} under)
    string(JSON over GET "${report}" frames ${i} signed_scores ${m} over)
    string(JSON color GET "${report}" frames ${i} signed_scores ${m} color_only)
    string(JSON under_rgb GET "${report}" frames ${i} signed_scores ${m} under_rgb_abs)
    string(JSON over_rgb GET "${report}" frames ${i} signed_scores ${m} over_rgb_abs)
    string(JSON color_rgb GET "${report}" frames ${i} signed_scores ${m} color_only_rgb_abs)
    string(JSON obs_diff GET "${report}" frames ${i} scores ${m} different)
    string(JSON obs_rgb GET "${report}" frames ${i} scores ${m} rgb_abs)
    math(EXPR diff_sum "${under}+${over}+${color}")
    math(EXPR rgb_sum "${under_rgb}+${over_rgb}+${color_rgb}")
    if(NOT name STREQUAL expected OR
       NOT diff_sum EQUAL obs_diff OR NOT rgb_sum EQUAL obs_rgb OR
       NOT color EQUAL 0 OR NOT color_rgb EQUAL 0)
      message(FATAL_ERROR "Per-frame heldout signed RGB/coverage not conserved")
    endif()
    math(EXPR u_${m} "${u_${m}}+${under}")
    math(EXPR o_${m} "${o_${m}}+${over}")
    math(EXPR c_${m} "${c_${m}}+${color}")
    math(EXPR ua_${m} "${ua_${m}}+${under_rgb}")
    math(EXPR oa_${m} "${oa_${m}}+${over_rgb}")
    math(EXPR ca_${m} "${ca_${m}}+${color_rgb}")
    math(EXPR ud_${d}_${m} "${ud_${d}_${m}}+${under}")
    math(EXPR od_${d}_${m} "${od_${d}_${m}}+${over}")
    math(EXPR cd_${d}_${m} "${cd_${d}_${m}}+${color}")
    math(EXPR uad_${d}_${m} "${uad_${d}_${m}}+${under_rgb}")
    math(EXPR oad_${d}_${m} "${oad_${d}_${m}}+${over_rgb}")
    math(EXPR cad_${d}_${m} "${cad_${d}_${m}}+${color_rgb}")
  endforeach()
  if(i EQUAL 68 OR i EQUAL 71)
    string(JSON shape GET "${report}" frames ${i} shape)
    string(JSON crop GET "${report}" frames ${i} crop)
    string(JSON rot GET "${report}" frames ${i} rotation)
    string(JSON dpi GET "${report}" frames ${i} dpi)
    string(JSON base GET "${report}" frames ${i} scores 0 rgb_abs)
    string(JSON one GET "${report}" frames ${i} scores 1 rgb_abs)
    string(JSON four GET "${report}" frames ${i} scores 2 rgb_abs)
    math(EXPR excess_one "${one}-${base}")
    math(EXPR excess_four "${four}-${base}")
    if(NOT shape EQUAL 1 OR NOT crop EQUAL 1 OR NOT dpi EQUAL 144 OR
       (NOT rot EQUAL 180 AND NOT rot EQUAL 270) OR
       NOT excess_one EQUAL 21974 OR NOT excess_four EQUAL 20954)
      message(FATAL_ERROR "Pinned 144DPI heldout 1/16,4/16 regressions changed")
    endif()
    math(EXPR pinned_observations "${pinned_observations}+1")
  endif()
endforeach()
if(NOT pinned_observations EQUAL 2)
  message(FATAL_ERROR "144DPI heldout regression pair incomplete")
endif()
foreach(m RANGE 0 6)
  list(GET signed_names ${m} expected)
  string(JSON name GET "${report}" total_signed_scores ${m} method)
  string(JSON u GET "${report}" total_signed_scores ${m} under)
  string(JSON o GET "${report}" total_signed_scores ${m} over)
  string(JSON c GET "${report}" total_signed_scores ${m} color_only)
  string(JSON ua GET "${report}" total_signed_scores ${m} under_rgb_abs)
  string(JSON oa GET "${report}" total_signed_scores ${m} over_rgb_abs)
  string(JSON ca GET "${report}" total_signed_scores ${m} color_only_rgb_abs)
  if(NOT name STREQUAL expected OR NOT u EQUAL u_${m} OR
     NOT o EQUAL o_${m} OR NOT c EQUAL c_${m} OR
     NOT ua EQUAL ua_${m} OR NOT oa EQUAL oa_${m} OR
     NOT ca EQUAL ca_${m})
    message(FATAL_ERROR "Global heldout signed under/over mismatch")
  endif()
  foreach(d RANGE 0 2)
    string(JSON name GET "${report}" signed_by_dpi ${d} ${m} method)
    string(JSON u GET "${report}" signed_by_dpi ${d} ${m} under)
    string(JSON o GET "${report}" signed_by_dpi ${d} ${m} over)
    string(JSON c GET "${report}" signed_by_dpi ${d} ${m} color_only)
    string(JSON ua GET "${report}" signed_by_dpi ${d} ${m} under_rgb_abs)
    string(JSON oa GET "${report}" signed_by_dpi ${d} ${m} over_rgb_abs)
    string(JSON ca GET "${report}" signed_by_dpi ${d} ${m} color_only_rgb_abs)
    if(NOT name STREQUAL expected OR
       NOT u EQUAL ud_${d}_${m} OR NOT o EQUAL od_${d}_${m} OR
       NOT c EQUAL cd_${d}_${m} OR
       NOT ua EQUAL uad_${d}_${m} OR
       NOT oa EQUAL oad_${d}_${m} OR
       NOT ca EQUAL cad_${d}_${m})
      message(FATAL_ERROR "Heldout 72/96/144 DPI signed coverage mismatch")
    endif()
  endforeach()
endforeach()
message(STATUS "#269 heldout 144DPI signed audit: original Q4 under=${u_0},"
  " over=${o_0}; 1/16 under=${u_1}, over=${o_1};"
  " two new shape-B crop-X+0.125 144DPI regressions retained."
  " Test-only; no native Raster pixel mutation.")
