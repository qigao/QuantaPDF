cmake_minimum_required(VERSION 3.20)
# #269 TEST ONLY. Second, genuinely fresh 18-source PDFium reference family.
# Floating source, coefficients, projected vertices and integral Clip/Fill
# decisions stay report-only. This cannot enable public/native raster.
if(NOT DEFINED ORACLE_EXECUTABLE OR ORACLE_EXECUTABLE STREQUAL "" OR
   NOT DEFINED REPORT_FILE OR REPORT_FILE STREQUAL "")
  message(FATAL_ERROR "Explicit mirrored Q4 oracle/report required")
endif()
file(REMOVE "${REPORT_FILE}" "${REPORT_FILE}.tmp")
execute_process(COMMAND "${ORACLE_EXECUTABLE}"
  --269-q4-mirror --mirror-report "${REPORT_FILE}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
  TIMEOUT 90)
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "Mirrored Q4 PDFium oracle rc=${rc}\n${stdout}\n${stderr}")
endif()
if(NOT EXISTS "${REPORT_FILE}")
  message(FATAL_ERROR "Mirrored Q4 atomic report missing")
endif()
file(READ "${REPORT_FILE}" report)
string(JSON source_kind GET "${report}" source_kind)
foreach(pair IN ITEMS
  "source_from_ir_export:false"
  "reference_only_not_native:true"
  "public_sdk_backend_switched:false"
  "native_renderer_modified:false"
  "external_native_positive_increment:0"
  "source_count:18"
  "source_bytes_verified:18"
  "reference_repeat_identical:54"
  "frame_count:54")
  string(REPLACE ":" ";" parts "${pair}")
  list(GET parts 0 field)
  list(GET parts 1 expected)
  string(JSON actual GET "${report}" ${field})
  # string(JSON) projects booleans as ON/OFF, not literal "false".
  if(expected STREQUAL "false")
    if(actual)
      message(FATAL_ERROR "Mirrored-Q4 nonpromotion flag ${field} became true")
    endif()
  elseif(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Mirrored-Q4 original source/status contract ${field}=${actual}")
  endif()
endforeach()
string(JSON num_models LENGTH "${report}" models)
string(JSON num_frames LENGTH "${report}" frames)
string(JSON num_global LENGTH "${report}" global_scores)
string(JSON num_dpi LENGTH "${report}" by_dpi)
if(NOT source_kind STREQUAL "new_mirrored_test_generated_original_pdf" OR
   NOT num_models EQUAL 8 OR NOT num_frames EQUAL 54 OR
   NOT num_global EQUAL 8 OR NOT num_dpi EQUAL 3)
  message(FATAL_ERROR "Mirrored-Q4 source/model inventory missing")
endif()
set(names
  source_double_q4_fill_q4_clip
  source_double_q4_fill_outer_clip
  source_double_closest_fill_outer_clip_lower_tie
  source_double_closest_fill_outer_clip_upper_tie
  float_coeff_closest_fill_outer_clip_lower_tie
  float_coeff_closest_fill_outer_clip_upper_tie
  float_vertex_closest_fill_outer_clip_lower_tie
  float_vertex_closest_fill_outer_clip_upper_tie)
foreach(m RANGE 0 7)
  list(GET names ${m} expected)
  string(JSON name GET "${report}" models ${m})
  if(NOT name STREQUAL expected)
    message(FATAL_ERROR "Mirrored Q4 method identity changed")
  endif()
  foreach(field IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
    set(total_${m}_${field} 0)
    foreach(d RANGE 0 2)
      set(dpi_${d}_${m}_${field} 0)
    endforeach()
  endforeach()
  set(win_${m} 0)
  set(lose_${m} 0)
  set(draw_${m} 0)
endforeach()
set(unique_hashes "")
set(flips_0 0)
set(flips_1 0)
set(flips_2 0)
set(pinned_observed 0)
foreach(i RANGE 0 53)
  string(JSON frame GET "${report}" frames ${i})
  math(EXPR source_index "${i}/3")
  math(EXPR expected_family "${source_index}/6")
  math(EXPR expected_phase "(${source_index}%6)/2")
  math(EXPR rotate_bit "${source_index}%2")
  math(EXPR dpi_bit "${i}%3")
  if(rotate_bit EQUAL 0)
    set(expected_rotation 180)
    set(source_width 24)
    set(source_height 18)
  else()
    set(expected_rotation 270)
    set(source_width 18)
    set(source_height 24)
  endif()
  if(dpi_bit EQUAL 0)
    set(expected_dpi 72)
  elseif(dpi_bit EQUAL 1)
    set(expected_dpi 96)
  else()
    set(expected_dpi 144)
  endif()
  math(EXPR expected_width "${source_width}*${expected_dpi}/72")
  math(EXPR expected_height "${source_height}*${expected_dpi}/72")
  foreach(key IN ITEMS frame source_index family phase rotation dpi)
    string(JSON got_${key} GET "${frame}" ${key})
  endforeach()
  string(JSON source_hash GET "${frame}" source_fnv64)
  string(JSON w GET "${frame}" grid 0)
  string(JSON h GET "${frame}" grid 1)
  string(JSON len LENGTH "${frame}" scores)
  if(NOT got_frame EQUAL i OR
     NOT got_source_index EQUAL source_index OR
     NOT got_family EQUAL expected_family OR
     NOT got_phase EQUAL expected_phase OR
     NOT got_rotation EQUAL expected_rotation OR
     NOT got_dpi EQUAL expected_dpi OR
     NOT w EQUAL expected_width OR NOT h EQUAL expected_height OR
     NOT len EQUAL 8 OR NOT source_hash MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Mirrored Q4 source geometry/frame ${i} invalid")
  endif()
  if(dpi_bit EQUAL 0)
    list(FIND unique_hashes "${source_hash}" previous)
    if(NOT previous EQUAL -1)
      message(FATAL_ERROR "Mirrored Q4 generated PDF bytes reused")
    endif()
    list(APPEND unique_hashes "${source_hash}")
  endif()
  foreach(d RANGE 0 2)
    string(JSON v GET "${frame}" stage_mask_flips ${d})
    if(v LESS 0)
      message(FATAL_ERROR "Negative model mask flip count")
    endif()
    math(EXPR flips_${d} "${flips_${d}}+${v}")
  endforeach()
  foreach(m RANGE 0 7)
    string(JSON score GET "${frame}" scores ${m})
    list(GET names ${m} expected)
    string(JSON name GET "${score}" method)
    if(NOT name STREQUAL expected)
      message(FATAL_ERROR "Model index ${m} changed in frame ${i}")
    endif()
    foreach(field IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
      string(JSON amount GET "${score}" ${field})
      math(EXPR total_${m}_${field} "${total_${m}_${field}}+${amount}")
      math(EXPR dpi_${dpi_bit}_${m}_${field}
         "${dpi_${dpi_bit}_${m}_${field}}+${amount}")
    endforeach()
    string(JSON under GET "${score}" under)
    string(JSON over GET "${score}" over)
    string(JSON ua GET "${score}" under_rgb_abs)
    string(JSON oa GET "${score}" over_rgb_abs)
    string(JSON rgb_abs GET "${score}" rgb_abs)
    math(EXPR errsum "${ua}+${oa}")
    if(NOT errsum EQUAL rgb_abs OR
       (under EQUAL 0 AND NOT ua EQUAL 0) OR
       (over EQUAL 0 AND NOT oa EQUAL 0))
      message(FATAL_ERROR "Frame ${i} model ${m} signed RGB not conserved")
    endif()
    if(m EQUAL 0)
      set(base ${rgb_abs})
    endif()
    if(rgb_abs GREATER base)
      math(EXPR lose_${m} "${lose_${m}}+1")
    elseif(rgb_abs LESS base)
      math(EXPR win_${m} "${win_${m}}+1")
    else()
      math(EXPR draw_${m} "${draw_${m}}+1")
    endif()
    if(m EQUAL 6 AND expected_family EQUAL 0 AND
       expected_rotation EQUAL 180 AND expected_dpi EQUAL 96 AND
       (expected_phase EQUAL 1 OR expected_phase EQUAL 2) AND
       rgb_abs GREATER base AND ua GREATER 0 AND oa GREATER 0)
      math(EXPR pinned_observed "${pinned_observed}+1")
    endif()
  endforeach()
endforeach()
list(LENGTH unique_hashes sources)
if(NOT sources EQUAL 18)
  message(FATAL_ERROR "Expected 18 UNIQUE PDF originals")
endif()
string(JSON pinned GET "${report}" new_f32_vertex_96dpi_mirrored_falsifiers)
if(NOT pinned EQUAL pinned_observed OR pinned LESS 1)
  message(FATAL_ERROR "Mirrored 96DPI float vertex counterexample missing")
endif()
foreach(d RANGE 0 2)
  string(JSON expected GET "${report}" stage_mask_flips ${d})
  if(NOT expected EQUAL flips_${d})
    message(FATAL_ERROR "Model mask stage transition conservation failed")
  endif()
endforeach()
foreach(m RANGE 0 7)
  string(JSON summary GET "${report}" global_scores ${m})
  list(GET names ${m} expected)
  string(JSON name GET "${summary}" method)
  if(NOT name STREQUAL expected)
    message(FATAL_ERROR "Mirrored model aggregate method name mismatch")
  endif()
  foreach(field IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
    string(JSON value GET "${summary}" ${field})
    if(NOT value EQUAL total_${m}_${field})
      message(FATAL_ERROR "Aggregate model ${m} ${field} not conserved")
    endif()
    foreach(d RANGE 0 2)
      string(JSON value GET "${report}" by_dpi ${d} ${m} ${field})
      if(NOT value EQUAL dpi_${d}_${m}_${field})
        message(FATAL_ERROR "DPI ${d} model ${m} ${field} mismatch")
      endif()
    endforeach()
  endforeach()
  string(JSON better GET "${summary}" better)
  string(JSON worse GET "${summary}" worse)
  string(JSON equal GET "${summary}" equal)
  if(NOT better EQUAL win_${m} OR
     NOT worse EQUAL lose_${m} OR NOT equal EQUAL draw_${m})
    message(FATAL_ERROR "Mirrored model per-frame regression ledger mismatch")
  endif()
  math(EXPR compared "${better}+${worse}+${equal}")
  if(NOT compared EQUAL 54)
    message(FATAL_ERROR "Mirrored model incomplete frames")
  endif()
endforeach()
if(lose_6 LESS 1)
  message(FATAL_ERROR "Previously promising float32-vertex Q4 model did not regress")
endif()
message(STATUS "#269 mirrored heldout: 18 new unique PDFs / 54 reference frames,"
  " 180/270 rotations, source/CropBox phase, independent Float32-vertex"
  " lower-tie regression retained. TEST ONLY; public SDK still PDFium.")
