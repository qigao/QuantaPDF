# #269 rectangle Fill/Clip RULE FALSIFICATION, TEST ONLY.
# Requires the prior 96 native RGBA and 144DPI reference signed checks.
# Candidate is not selected for production, regardless of the old 96 score.
if(NOT DEFINED report OR report STREQUAL "")
  message(FATAL_ERROR "Previous original PDFium/Native report missing")
endif()
# One large report read and ONE subtree extraction. Repeated string(JSON)
# on 278KB for every tiny scalar causes a Windows CTest timeout.
string(JSON phase_json GET "${phase_json}")
string(JSON legacy_zero GET "${report}" rect_closest_outer_legacy_zero_frames)
string(JSON old_q4 GET "${report}" rect_closest_outer_legacy_q4_total rgb_abs)
string(JSON old_candidate GET "${report}" rect_closest_outer_legacy_candidate_total rgb_abs)
string(JSON original_q4 GET "${report}" total_scores 0 rgb_abs)
string(JSON kind GET "${phase_json}" source_kind)
string(JSON no_promotion GET "${phase_json}" external_native_positive_increment)
string(JSON no_raster GET "${phase_json}" native_renderer_modified)
string(JSON modeled GET "${phase_json}" modeled_q4_not_production_native)
string(JSON sources GET "${phase_json}" source_count)
string(JSON verified GET "${phase_json}" source_bytes_verified)
string(JSON frames GET "${phase_json}" reference_frames)
string(JSON regressed GET "${phase_json}" pinned_96dpi_regression_frames)
string(JSON frame_len LENGTH "${phase_json}" samples)
if(NOT legacy_zero EQUAL 96 OR NOT old_q4 EQUAL original_q4 OR
   NOT old_candidate EQUAL 0 OR NOT original_q4 EQUAL 3818356 OR
   NOT kind STREQUAL "six_new_test_generated_original_pdf" OR
   NOT no_promotion EQUAL 0 OR no_raster OR NOT modeled OR
   NOT sources EQUAL 6 OR NOT verified EQUAL 6 OR
   NOT frames EQUAL 18 OR NOT regressed EQUAL 6 OR NOT frame_len EQUAL 18)
  message(FATAL_ERROR "Heldout rectangle-quantization scope/provenance changed")
endif()
foreach(which IN ITEMS q4 closest_fill_outer_clip)
  foreach(k IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
    set(sum_${which}_${k} 0)
  endforeach()
endforeach()
set(regressed_again 0)
foreach(i RANGE 0 17)
  math(EXPR src_id "${i}/3")
  math(EXPR dpi_id "${i}%3")
  math(EXPR phase_id "${src_id}/2")
  math(EXPR mode_id "${src_id}%2")
  if(dpi_id EQUAL 0)
    set(expected_dpi 72)
  elseif(dpi_id EQUAL 1)
    set(expected_dpi 96)
  else()
    set(expected_dpi 144)
  endif()
  if(mode_id EQUAL 0)
    set(expected_mode fill_only)
  else()
    set(expected_mode fill_and_w_clip)
  endif()
  string(JSON id GET "${phase_json}" samples ${i} frame)
  string(JSON phase GET "${phase_json}" samples ${i} phase)
  string(JSON mode GET "${phase_json}" samples ${i} mode)
  string(JSON dpi GET "${phase_json}" samples ${i} dpi)
  string(JSON rotation GET "${phase_json}" samples ${i} rotation)
  string(JSON source_hash GET "${phase_json}" samples ${i} source_fnv64)
  if(NOT id EQUAL i OR NOT phase EQUAL phase_id OR
     NOT mode STREQUAL expected_mode OR NOT dpi EQUAL expected_dpi OR
     NOT rotation EQUAL 90 OR NOT source_hash MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "New original-PDF phase/fill/clip source evidence missing")
  endif()
  foreach(which IN ITEMS q4 closest_fill_outer_clip)
    string(JSON under GET "${phase_json}" samples ${i} ${which} under)
    string(JSON over GET "${phase_json}" samples ${i} ${which} over)
    string(JSON under_abs GET "${phase_json}" samples ${i} ${which} under_rgb_abs)
    string(JSON over_abs GET "${phase_json}" samples ${i} ${which} over_rgb_abs)
    string(JSON all_abs GET "${phase_json}" samples ${i} ${which} rgb_abs)
    math(EXPR conserved "${under_abs}+${over_abs}")
    if(NOT conserved EQUAL all_abs OR
       (under EQUAL 0 AND NOT under_abs EQUAL 0) OR
       (over EQUAL 0 AND NOT over_abs EQUAL 0))
      message(FATAL_ERROR "New original frame signed under/over RGB ledger broken")
    endif()
    foreach(pair IN ITEMS
        "under:${under}" "over:${over}"
        "under_rgb_abs:${under_abs}" "over_rgb_abs:${over_abs}"
        "rgb_abs:${all_abs}")
      string(REPLACE ":" ";" parts "${pair}")
      list(GET parts 0 key)
      list(GET parts 1 val)
      math(EXPR sum_${which}_${key} "${sum_${which}_${key}}+${val}")
    endforeach()
  endforeach()
  string(JSON old_abs GET "${phase_json}" samples ${i} q4 rgb_abs)
  string(JSON candidate_abs GET "${phase_json}" samples ${i} closest_fill_outer_clip rgb_abs)
  if(dpi_id EQUAL 1)
    if(NOT candidate_abs GREATER old_abs)
      message(FATAL_ERROR "96DPI new-source half-pixel counterexample lost")
    endif()
    math(EXPR regressed_again "${regressed_again}+1")
  endif()
endforeach()
if(NOT regressed_again EQUAL 6)
  message(FATAL_ERROR "Missing exactly six new original half-pixel cases")
endif()
foreach(which IN ITEMS q4 closest_fill_outer_clip)
  foreach(k IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
    if(which STREQUAL "closest_fill_outer_clip")
      set(summary_name "nearest_fill_outer_clip_total")
    else()
      set(summary_name "q4_total")
    endif()
    string(JSON recorded GET "${phase_json}" ${summary_name} ${k})
    if(NOT sum_${which}_${k} EQUAL recorded)
      message(FATAL_ERROR "Original 18-frame quantization aggregate is not conserved")
    endif()
  endforeach()
endforeach()
message(STATUS "#269 rect Fill/Clip quantization falsified on 6 distinct"
  " new test-generated PDF originals, each checked at 72/96/144DPI:"
  " six 96DPI regressions despite 96/96 legacy zero-RGB fits."
  " Test-only, no native Raster change or external-positive promotion.")
