cmake_minimum_required(VERSION 3.20)
# Test-only original-PDF Q4 stage-order matrix; never selects a backend.
if(NOT DEFINED ORACLE_EXECUTABLE OR ORACLE_EXECUTABLE STREQUAL "" OR
   NOT DEFINED REPORT_FILE OR REPORT_FILE STREQUAL "")
  message(FATAL_ERROR "Explicit stage-order oracle/report required")
endif()
file(REMOVE "${REPORT_FILE}" "${REPORT_FILE}.tmp")
execute_process(COMMAND "${ORACLE_EXECUTABLE}"
  --269-q4-stage-order --stage-order-report "${REPORT_FILE}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 90)
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "Q4 stage-order oracle rc=${rc}\n${stdout}\n${stderr}")
endif()
if(NOT EXISTS "${REPORT_FILE}")
  message(FATAL_ERROR "Q4 stage-order report not published atomically")
endif()
file(READ "${REPORT_FILE}" report)
string(JSON kind GET "${report}" source_kind)
foreach(flag IN ITEMS
  reference_only_not_native_renderer
  independent_from_374_six_source_geometry
  no_renderer_or_sdk_mutation)
  string(JSON actual GET "${report}" ${flag})
  if(NOT actual)
    message(FATAL_ERROR "Stage-order nonpromotion flag ${flag} missing")
  endif()
endforeach()
foreach(pair IN ITEMS "source_count:18" "source_bytes_verified:18"
   "reference_repeat_identical:54" "frame_count:54"
   "reference_partial_pixels:0" "external_native_positive_increment:0")
  string(REPLACE ":" ";" parts "${pair}")
  list(GET parts 0 key)
  list(GET parts 1 expected)
  string(JSON actual GET "${report}" ${key})
  if(NOT actual EQUAL expected)
    message(FATAL_ERROR "Stage-order source/reference scope mismatch ${key}")
  endif()
endforeach()
string(JSON frames_len LENGTH "${report}" frames)
string(JSON names_len LENGTH "${report}" models)
string(JSON totals_len LENGTH "${report}" global_scores)
string(JSON dpis_len LENGTH "${report}" by_dpi)
if(NOT kind STREQUAL "new_test_generated_original_pdf_not_external" OR
   NOT frames_len EQUAL 54 OR NOT names_len EQUAL 8 OR
   NOT totals_len EQUAL 8 OR NOT dpis_len EQUAL 3)
  message(FATAL_ERROR "Stage-order frame/method schema mismatch")
endif()
set(names
  source_double_q4_fill_q4_clip
  source_double_q4_fill_outer_clip
  source_double_closest_fill_outer_clip_lower_tie
  source_double_closest_fill_outer_clip_upper_tie
  float_coeff_closest_fill_outer_clip_lower_tie
  float_coeff_closest_fill_outer_clip_upper_tie
  float_vertex_closest_fill_outer_clip_lower_tie
  float_vertex_closest_fill_outer_clip_upper_tie)
foreach(m RANGE 0 7)
  list(GET names ${m} expected)
  string(JSON model GET "${report}" models ${m})
  if(NOT model STREQUAL expected)
    message(FATAL_ERROR "Stage-order model order changed")
  endif()
  foreach(field IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
    set(total_${m}_${field} 0)
    foreach(j RANGE 0 2)
      set(dpi_${j}_${m}_${field} 0)
    endforeach()
  endforeach()
  set(win_${m} 0)
  set(lose_${m} 0)
  set(draw_${m} 0)
endforeach()
set(unique_hashes "")
set(tie_total 0)
set(coeff_total 0)
set(vertex_total 0)
foreach(i RANGE 0 53)
  # Extract a small per-frame subtree instead of reparsing the whole JSON.
  string(JSON frame GET "${report}" frames ${i})
  math(EXPR expected_source "${i}/3")
  math(EXPR expected_family "${expected_source}/6")
  math(EXPR expected_phase "(${expected_source}%6)/2")
  math(EXPR rotation_index "${expected_source}%2")
  math(EXPR dpi_index "${i}%3")
  if(rotation_index EQUAL 0)
    set(expected_rotation 0)
  else()
    set(expected_rotation 90)
  endif()
  if(dpi_index EQUAL 0)
    set(expected_dpi 72)
  elseif(dpi_index EQUAL 1)
    set(expected_dpi 96)
  else()
    set(expected_dpi 144)
  endif()
  if(rotation_index EQUAL 0)
    math(EXPR expected_w "24*${expected_dpi}/72")
    math(EXPR expected_h "18*${expected_dpi}/72")
  else()
    math(EXPR expected_w "18*${expected_dpi}/72")
    math(EXPR expected_h "24*${expected_dpi}/72")
  endif()
  string(JSON frame_id GET "${frame}" frame)
  string(JSON source_id GET "${frame}" source_index)
  string(JSON family GET "${frame}" family)
  string(JSON phase GET "${frame}" phase)
  string(JSON rotation GET "${frame}" rotation)
  string(JSON dpi GET "${frame}" dpi)
  string(JSON source_hash GET "${frame}" source_fnv64)
  string(JSON partial GET "${frame}" partial)
  string(JSON width GET "${frame}" grid 0)
  string(JSON height GET "${frame}" grid 1)
  string(JSON methods LENGTH "${frame}" scores)
  if(NOT frame_id EQUAL i OR NOT source_id EQUAL expected_source OR
     NOT family EQUAL expected_family OR NOT phase EQUAL expected_phase OR
     NOT rotation EQUAL expected_rotation OR NOT dpi EQUAL expected_dpi OR
     NOT partial EQUAL 0 OR NOT width EQUAL expected_w OR
     NOT height EQUAL expected_h OR NOT methods EQUAL 8 OR
     NOT source_hash MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Stage-order source/geometry incomplete frame ${i}")
  endif()
  if(dpi_index EQUAL 0)
    list(FIND unique_hashes "${source_hash}" seen)
    if(NOT seen EQUAL -1)
      message(FATAL_ERROR "Stage-order duplicate source PDF bytes")
    endif()
    list(APPEND unique_hashes "${source_hash}")
  endif()
  string(JSON tie GET "${frame}" tie_low_vs_high_pixels)
  string(JSON coeff GET "${frame}" double_vs_float_coeff_pixels)
  string(JSON vertex GET "${frame}" float_coeff_vs_vertex_pixels)
  if(tie LESS 0 OR coeff LESS 0 OR vertex LESS 0)
    message(FATAL_ERROR "Negative stage-order mask transition count")
  endif()
  math(EXPR tie_total "${tie_total}+${tie}")
  math(EXPR coeff_total "${coeff_total}+${coeff}")
  math(EXPR vertex_total "${vertex_total}+${vertex}")
  foreach(m RANGE 0 7)
    string(JSON score GET "${frame}" scores ${m})
    list(GET names ${m} expected)
    string(JSON name GET "${score}" method)
    if(NOT name STREQUAL expected)
      message(FATAL_ERROR "Stage-order method mismatch ${i}:${m}")
    endif()
    foreach(field IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
      string(JSON value GET "${score}" ${field})
      math(EXPR total_${m}_${field} "${total_${m}_${field}}+${value}")
      math(EXPR dpi_${dpi_index}_${m}_${field}
        "${dpi_${dpi_index}_${m}_${field}}+${value}")
    endforeach()
    string(JSON under GET "${score}" under)
    string(JSON over GET "${score}" over)
    string(JSON ua GET "${score}" under_rgb_abs)
    string(JSON oa GET "${score}" over_rgb_abs)
    string(JSON rgb GET "${score}" rgb_abs)
    math(EXPR sum "${ua}+${oa}")
    if(NOT sum EQUAL rgb OR
       (under EQUAL 0 AND NOT ua EQUAL 0) OR
       (over EQUAL 0 AND NOT oa EQUAL 0))
      message(FATAL_ERROR "Stage-order signed RGB conservation error ${i}:${m}")
    endif()
    if(m EQUAL 0)
      set(baseline ${rgb})
    endif()
    if(rgb GREATER baseline)
      math(EXPR lose_${m} "${lose_${m}}+1")
    elseif(rgb LESS baseline)
      math(EXPR win_${m} "${win_${m}}+1")
    else()
      math(EXPR draw_${m} "${draw_${m}}+1")
    endif()
  endforeach()
endforeach()
list(LENGTH unique_hashes distinct)
if(NOT distinct EQUAL 18 OR tie_total LESS 1)
  message(FATAL_ERROR "18 new original sources/tie phase evidence absent")
endif()
foreach(m RANGE 0 7)
  string(JSON summary GET "${report}" global_scores ${m})
  list(GET names ${m} expected)
  string(JSON name GET "${summary}" method)
  if(NOT name STREQUAL expected)
    message(FATAL_ERROR "Stage-order summary method changed")
  endif()
  foreach(field IN ITEMS under over under_rgb_abs over_rgb_abs rgb_abs)
    string(JSON value GET "${summary}" ${field})
    if(NOT value EQUAL total_${m}_${field})
      message(FATAL_ERROR "Stage-order global RGB mismatch ${m}:${field}")
    endif()
    foreach(j RANGE 0 2)
      string(JSON v GET "${report}" by_dpi ${j} ${m} ${field})
      if(NOT v EQUAL dpi_${j}_${m}_${field})
        message(FATAL_ERROR "Stage-order DPI RGB mismatch ${j}:${m}:${field}")
      endif()
    endforeach()
  endforeach()
  string(JSON loss GET "${summary}" worse_than_q4)
  string(JSON win GET "${summary}" better_than_q4)
  string(JSON draw GET "${summary}" equal_q4)
  if(NOT loss EQUAL lose_${m} OR NOT win EQUAL win_${m} OR
     NOT draw EQUAL draw_${m})
    message(FATAL_ERROR "Stage-order per-frame regression ledger mismatch")
  endif()
  math(EXPR num "${loss}+${win}+${draw}")
  if(NOT num EQUAL 54)
    message(FATAL_ERROR "Stage-order incomplete comparison coverage")
  endif()
endforeach()
string(JSON tie_saved GET "${report}" tie_sensitive_pixels)
string(JSON coeff_saved GET "${report}" double_to_float_coeff_pixels)
string(JSON vert_saved GET "${report}" float_coeff_to_vertex_pixels)
if(NOT tie_saved EQUAL tie_total OR
   NOT coeff_saved EQUAL coeff_total OR
   NOT vert_saved EQUAL vertex_total)
  message(FATAL_ERROR "Stage-order ownership transitions not conserved")
endif()
# The local PDFium149 screen falsified both global tie choices; fail closed
# if the pinned PDFium154 experiment cannot reproduce that test evidence.
if(lose_2 LESS 1 OR lose_3 LESS 1)
  message(FATAL_ERROR "Lower/upper tie negative evidence missing")
endif()
message(STATUS "#269 Q4 stage-order: 18 distinct test-generated original PDFs,"
  " 54 independently repeated PDFium frames, eight models, signed per-DPI"
  " ledgers, both tie-policies regress. Test-only; SDK still PDFium.")
