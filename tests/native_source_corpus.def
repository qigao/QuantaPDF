/* Test-only generated source-PDF conformance FAMILY registry.
 * Each row is one executable group. The family_count is the exact number
 * of PDFs generated/tested by that group (not number of rendered pages).
 *
 * QP_SOURCE_CORPUS_FAMILY(id, feature_tags, expected_result, oracle,
 *                         fixture_count, test_function)
 * expected_result: accepted | rejected | mixed
 * oracle: original-pdfium | native-only | status-only
 *
 * These are generated, test-owned PDFs, not an external licensed corpus.
 * This X-macro list is compiled into the test runner, which checks that
 * every listed group executes its declared number of fixtures.
 */
#ifndef QP_SOURCE_CORPUS_FAMILY
#error "Define QP_SOURCE_CORPUS_FAMILY before including the corpus registry"
#endif
