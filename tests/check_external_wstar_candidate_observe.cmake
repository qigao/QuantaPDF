# Test-only typed observation of an unchanged independently published W* PDF.
# No native raster, PDFium pixel oracle or corpus admission occurs here.
cmake_minimum_required(VERSION 3.24)
foreach(name IN ITEMS ORACLE SOURCE REPORT EXPECTED_SHA256)
  if(NOT DEFINED ${name} OR "${${name}}" STREQUAL "")
    message(FATAL_ERROR "Missing required ${name}")
  endif()
endforeach()
if(NOT EXISTS "${SOURCE}")
  message(FATAL_ERROR "Original PDF candidate not present")
endif()
file(SIZE "${SOURCE}" nbytes)
if(NOT nbytes EQUAL 3747)
  message(FATAL_ERROR "Changed original byte count: ${nbytes}")
endif()
file(SHA256 "${SOURCE}" before)
if(NOT "${before}" STREQUAL "${EXPECTED_SHA256}")
  message(FATAL_ERROR "Source SHA256 mismatch before typed observe: ${before}")
endif()
execute_process(
  COMMAND "${ORACLE}" --preflight-original-pdf "${SOURCE}"
     --page-index 0 --expect-status observe --preflight-report "${REPORT}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE err)
if(NOT "${rc}" STREQUAL "0")
  message(FATAL_ERROR "Actual original-source typed observe failed: ${rc}: ${err}")
endif()
file(READ "${REPORT}" json)
string(JSON typed GET "${json}" native_lower_status)
string(JSON observed GET "${json}" observation_only)
string(JSON provenance GET "${json}" original_source_provenance_verified)
string(JSON released GET "${json}" source_document_graph_released)
string(JSON pages GET "${json}" detached_ir_pages)
string(JSON operations GET "${json}" detached_ir_operations)
string(JSON nonzero GET "${json}" detached_ir_w_nonzero_clip_path_leaves)
string(JSON wstar GET "${json}" detached_ir_wstar_evenodd_clip_path_leaves)
string(JSON clips GET "${json}" detached_ir_clips)
string(JSON states GET "${json}" detached_ir_graphics_states)
string(JSON pixel GET "${json}" original_pdfium_pixel_oracle)
string(JSON raster GET "${json}" native_raster)
string(JSON count GET "${json}" external_wstar_pixel_supported_count)
string(JSON generated GET "${json}" generated_fixture_count)
if(NOT observed OR provenance OR NOT released OR NOT pixel STREQUAL "not_run"
   OR NOT raster STREQUAL "not_run" OR NOT count EQUAL 0 OR NOT generated EQUAL 0)
  message(FATAL_ERROR "Original candidate observe violated no-provenance/no-pixel gate")
endif()
if("${typed}" STREQUAL "lowered")
  if(NOT pages EQUAL 1 OR operations LESS 1 OR wstar LESS 1)
    message(FATAL_ERROR "Lowered original failed real W* owned clip assertion")
  endif()
elseif("${typed}" STREQUAL "unsupported")
  if(NOT pages EQUAL 0 OR NOT operations EQUAL 0 OR NOT clips EQUAL 0
     OR NOT states EQUAL 0 OR NOT wstar EQUAL 0 OR NOT nonzero EQUAL 0)
    message(FATAL_ERROR "Unsupported original leaked partial IR")
  endif()
else()
  message(FATAL_ERROR "Unexpected typed status: ${typed}")
endif()
file(SHA256 "${SOURCE}" after)
if(NOT "${before}" STREQUAL "${after}")
  message(FATAL_ERROR "Original source bytes mutated by typed observe")
endif()
message(STATUS "yworks Wstar original candidate: typed=${typed} evenodd=${wstar} sha256=${after} pixel=not_run external_positive=0")
