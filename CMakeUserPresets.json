{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "host-environment",
      "hidden": true,
      "environment": {
        "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "win-vcpkg",
      "hidden": true,
      "inherits": "host-environment",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux-vcpkg",
      "hidden": true,
      "inherits": "host-environment",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "macos-vcpkg",
      "hidden": true,
      "inherits": "host-environment",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "win-dev-user",
      "displayName": "QuantaPDF Developer (Windows, MSVC + ASan)",
      "inherits": [
        "win-vcpkg",
        "base-win-dev-user"
      ],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_C_FLAGS": "/fsanitize=address /Zi",
        "CMAKE_CXX_FLAGS": "/fsanitize=address /Zi /EHsc /D_DISABLE_VECTOR_ANNOTATION /D_DISABLE_STRING_ANNOTATION /D_DISABLE_OPTIONAL_ANNOTATION",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows-static-md/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/quantapdf/debug"
      },
      "environment": {
        "PATH": "${sourceDir}/build/Msvc${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows-static-md/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows-static-md/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "win-release-user",
      "displayName": "QuantaPDF Release (Windows, MSVC)",
      "inherits": [
        "win-vcpkg",
        "base-win-release-user"
      ],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows-static-md",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/quantapdf/release"
      },
      "environment": {
        "PATH": "${sourceDir}/build/Msvc-Release${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows-static-md/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "linux-dev-user",
      "displayName": "QuantaPDF Developer (Linux, GCC + ASan/UBSan)",
      "inherits": [
        "linux-vcpkg",
        "base-linux-dev-user"
      ],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/quantapdf/debug"
      },
      "environment": {
        "LD_LIBRARY_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "linux-release-user",
      "displayName": "QuantaPDF Release (Linux, GCC)",
      "inherits": [
        "linux-vcpkg",
        "base-linux-release-user"
      ],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/quantapdf/release"
      },
      "environment": {
        "LD_LIBRARY_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "macos-x64-release-user",
      "displayName": "QuantaPDF Release (macOS x64, Clang)",
      "inherits": [
        "macos-vcpkg",
        "base-macos-release-user"
      ],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-osx",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/quantapdf/release"
      },
      "environment": {
        "DYLD_LIBRARY_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-osx/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      }
    },
    {
      "name": "macos-arm64-release-user",
      "displayName": "QuantaPDF Release (macOS arm64, Clang)",
      "inherits": [
        "macos-vcpkg",
        "base-macos-release-user"
      ],
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/arm64-osx",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/quantapdf/release"
      },
      "environment": {
        "DYLD_LIBRARY_PATH": "$env{VCPKG_INSTALLED_DIR}/arm64-osx/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-dev-user", "configurePreset": "win-dev-user" },
    { "name": "win-release-user", "configurePreset": "win-release-user" },
    { "name": "linux-dev-user", "configurePreset": "linux-dev-user" },
    { "name": "linux-release-user", "configurePreset": "linux-release-user" },
    { "name": "macos-x64-release-user", "configurePreset": "macos-x64-release-user" },
    { "name": "macos-arm64-release-user", "configurePreset": "macos-arm64-release-user" },
    { "name": "install-win-dev-user", "configurePreset": "win-dev-user", "targets": ["install"] },
    { "name": "install-win-release-user", "configurePreset": "win-release-user", "targets": ["install"] },
    { "name": "install-linux-dev-user", "configurePreset": "linux-dev-user", "targets": ["install"] },
    { "name": "install-linux-release-user", "configurePreset": "linux-release-user", "targets": ["install"] },
    { "name": "install-macos-x64-release-user", "configurePreset": "macos-x64-release-user", "targets": ["install"] },
    { "name": "install-macos-arm64-release-user", "configurePreset": "macos-arm64-release-user", "targets": ["install"] }
  ],
  "testPresets": [
    { "name": "win-dev-user", "inherits": "base-test", "configurePreset": "win-dev-user" },
    { "name": "win-release-user", "inherits": "base-test", "configurePreset": "win-release-user" },
    { "name": "linux-dev-user", "inherits": "base-test", "configurePreset": "linux-dev-user" },
    { "name": "linux-release-user", "inherits": "base-test", "configurePreset": "linux-release-user" },
    { "name": "macos-x64-release-user", "inherits": "base-test", "configurePreset": "macos-x64-release-user" },
    { "name": "macos-arm64-release-user", "inherits": "base-test", "configurePreset": "macos-arm64-release-user" }
  ]
}
